# Application
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Any OpenAI-compatible endpoint can be used. The default is local Ollama.
HARNESS_LLM_ENDPOINT=http://localhost:11434
HARNESS_LLM_MODEL=qwen2.5:7b
HARNESS_LLM_API_KEY=
