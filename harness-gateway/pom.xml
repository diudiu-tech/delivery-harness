<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.delivery.harness</groupId>
        <artifactId>delivery-harness</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>harness-gateway</artifactId>
    <name>Harness Gateway</name>
    <description>Spring Boot HTTP entry point, validation, routing, and request tracing</description>

    <dependencies>
        <dependency>
            <groupId>com.delivery.harness</groupId>
            <artifactId>harness-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.delivery.harness</groupId>
            <artifactId>harness-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.delivery.harness</groupId>
            <artifactId>harness-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.delivery.harness</groupId>
            <artifactId>harness-eval</artifactId>
        </dependency>
        <dependency>
            <groupId>com.delivery.harness</groupId>
            <artifactId>harness-observe</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
