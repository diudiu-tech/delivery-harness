# Application
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Any OpenAI-compatible endpoint can be used. The default is local Ollama.
HARNESS_LLM_ENDPOINT=http://localhost:11434
HARNESS_LLM_MODEL=qwen2.5:7b
HARNESS_LLM_ALLOWED_HOSTS=
HARNESS_LLM_API_KEY=
HARNESS_LLM_TIMEOUT_SECONDS=120

# Advisory compensation guardrail used by this MVP.
HARNESS_MAX_COMPENSATION_AMOUNT=50.0

# Local demo only: blank chooses five public synthetic identities; [] disables them.
# agent, reviewer, supervisor, admin and independent publisher use demo-<role>-token.
HARNESS_MODE=demo
HARNESS_DEMO_IDENTITIES=
HARNESS_BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
HARNESS_BROWSER_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Pilot requires your real IdP and rejects demo/static identities.
HARNESS_OIDC_ISSUER=
HARNESS_OIDC_AUDIENCE=
HARNESS_OIDC_JWK_SET_URI=
