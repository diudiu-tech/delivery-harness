# Load manually with your process manager or `set -a; source .env; set +a`.
# This file is an example; the application does not automatically read .env.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
HARNESS_MODE=demo
# Demo is in memory by default. Use a file URL to exercise restart recovery.
HARNESS_DATABASE_URL='jdbc:h2:mem:harness;DB_CLOSE_DELAY=-1'
HARNESS_DATABASE_USERNAME=sa
HARNESS_DATABASE_PASSWORD=
# Every /api request requires an explicit Authorization: Bearer header.
# Loopback demo credentials: demo-agent-token (AGENT/OPERATOR), demo-reviewer-token (REVIEWER),
# demo-supervisor-token (REVIEWER/SUPERVISOR), demo-admin-token (POLICY_EDITOR/QUALITY/AUDITOR/ADMIN),
# demo-publisher-token (QUALITY/POLICY_PUBLISHER, independent of the author).
# Override with JSON records containing token_sha256 + tenant_id/user_id/roles/city_codes/station_ids.
# Never store cleartext real tokens in this file. Leave unset/blank for the five demo identities.
# Set HARNESS_DEMO_IDENTITIES='[]' to disable every public demo credential.
# HARNESS_DEMO_IDENTITIES='[{"token_sha256":"<64 hex SHA-256>","tenant_id":"demo","user_id":"reviewer","roles":["REVIEWER"],"city_codes":["*"],"station_ids":["*"]}]'
HARNESS_BROWSER_ALLOWED_HOSTS='localhost,127.0.0.1,[::1]'
HARNESS_BROWSER_ALLOWED_ORIGINS='http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080'
# Pilot requires persistent JDBC, OIDC issuer/audience, and an allowlisted read-only source.
# Pilot HARNESS_DEMO_IDENTITIES must be [] (or unset); static token identity maps are rejected.
# JWT requires RS256 signature, issuer, audience, exp, sub, tenant_id, roles, city_codes and station_ids.
HARNESS_OIDC_ISSUER=
HARNESS_OIDC_AUDIENCE=
# Optional HTTPS JWK endpoint; otherwise keys are discovered from the HTTPS OIDC issuer.
HARNESS_OIDC_JWK_SET_URI=
# HARNESS_DATABASE_URL=jdbc:postgresql://localhost:5432/harness
# HARNESS_DATABASE_USERNAME=harness
# HARNESS_DATABASE_PASSWORD=<secret>
HARNESS_ORDER_ENDPOINT=
HARNESS_ORDER_ALLOWED_HOSTS=
HARNESS_ORDER_TOKEN=
HARNESS_LLM_ENDPOINT=http://localhost:11434
HARNESS_LLM_MODEL=qwen2.5:7b
HARNESS_LLM_ALLOWED_HOSTS=
HARNESS_LLM_API_KEY=
HARNESS_LLM_TIMEOUT_SECONDS=120
# New demo runtime-default-v1 is deterministic and does not require a model.
HARNESS_DETERMINISTIC_ONLY=false
HARNESS_EXECUTION_WORKERS=2
HARNESS_EXECUTION_QUEUE=50
HARNESS_EXECUTION_DEADLINE_SECONDS=15
HARNESS_REVIEW_APPROVAL_THRESHOLD=10.00
HARNESS_MAX_COMPENSATION_AMOUNT=50.00
HARNESS_BUILD_GIT_SHA=UNKNOWN
