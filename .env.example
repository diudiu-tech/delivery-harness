# Load manually with your process manager or `set -a; source .env; set +a`.
# This file is an example; the application does not automatically read .env.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
HARNESS_MODE=demo
# Demo is in memory by default. Use a file URL to exercise restart recovery.
HARNESS_DATABASE_URL='jdbc:h2:mem:harness;DB_CLOSE_DELAY=-1'
HARNESS_DATABASE_USERNAME=sa
HARNESS_DATABASE_PASSWORD=
# Demo anonymous identity is demo-agent. This second identity enables independent verification.
# Replace every token before using pilot. Never commit real credentials.
HARNESS_AUTH_TOKENS='[{"token":"demo-reviewer","tenant_id":"demo","user_id":"reviewer-2","roles":["AGENT","OPERATOR","REVIEWER","SUPERVISOR","POLICY_EDITOR","POLICY_PUBLISHER","QUALITY","ADMIN","AUDITOR"],"city_codes":["*"],"station_ids":["*"]}]'
# pilot requires a persistent JDBC URL, identities, and an allowlisted read-only source.
# HARNESS_DATABASE_URL=jdbc:postgresql://localhost:5432/harness
# HARNESS_DATABASE_USERNAME=harness
# HARNESS_DATABASE_PASSWORD=<secret>
HARNESS_ORDER_ENDPOINT=
HARNESS_ORDER_ALLOWED_HOSTS=
HARNESS_ORDER_TOKEN=
HARNESS_LLM_ENDPOINT=http://localhost:11434
HARNESS_LLM_MODEL=qwen2.5:7b
HARNESS_LLM_ALLOWED_HOSTS=
HARNESS_LLM_API_KEY=
HARNESS_LLM_TIMEOUT_SECONDS=120
# New demo runtime-default-v1 is deterministic and does not require a model.
HARNESS_DETERMINISTIC_ONLY=false
HARNESS_EXECUTION_WORKERS=2
HARNESS_EXECUTION_QUEUE=50
HARNESS_EXECUTION_DEADLINE_SECONDS=15
HARNESS_REVIEW_APPROVAL_THRESHOLD=10.00
HARNESS_MAX_COMPENSATION_AMOUNT=50.00
HARNESS_BUILD_GIT_SHA=UNKNOWN
# Funds extension is closed by default and never callable by a model.
HARNESS_COMPENSATION_EXECUTION_ENABLED=false
HARNESS_COMPENSATION_CHANNEL_ENDPOINT=
HARNESS_COMPENSATION_ALLOWED_HOSTS=
HARNESS_COMPENSATION_CHANNEL_TOKEN=
HARNESS_COMPENSATION_CALLBACK_SECRET=
# Retention always requires a reviewed plan and independent administrator approval.
HARNESS_RETENTION_ENABLED=false
HARNESS_RETENTION_CASE_DAYS=180
